# The rts menu run by the arm9 at RTS_BASE (common/sharedMemory.h).
# Output: rtsmenu9.bin, to be copied to /_pico/ on the sd card.
# font.bin is generated by tools/mkfont.py from DejaVu Sans Mono and kept in git.
PREFIX ?= arm-none-eabi-
CFLAGS := -mcpu=arm946e-s -marm -Os -ffreestanding -fno-builtin -fno-tree-loop-distribute-patterns -nostdlib -Wall -Wextra -I../common
rtsmenu9.bin: rtsmenu9.elf
	$(PREFIX)objcopy -O binary $< $@
rtsmenu9.elf: start.o menu.o state.o rtsmenu.ld
	$(PREFIX)gcc $(CFLAGS) -T rtsmenu.ld -Wl,-Map,rtsmenu9.map start.o menu.o state.o -lgcc -o $@
start.o: start.s font.bin
	$(PREFIX)as -mcpu=arm946e-s $< -o $@
%.o: %.c rtsmenu.h state.h
	$(PREFIX)gcc $(CFLAGS) -c $< -o $@
clean:
	rm -f *.o rtsmenu9.elf rtsmenu9.bin rtsmenu9.map
