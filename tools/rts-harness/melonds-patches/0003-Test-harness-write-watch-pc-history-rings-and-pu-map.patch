+++ b/src/CP15.cpp
@@ -151,6 +151,27 @@ void ARMv5::UpdateITCMSetting()
 // covers updates to a specific PU region's cache/etc settings
 // (not to the region range/enabled status)
 void ARMv5::UpdatePURegion(u32 n)
+{
+    if (!(CP15Control & 1)) { PU_SetValid[0] = false; return; }
+    PU_SetKey[0] = PUKey();
+    // a higher region wins where regions overlap: put back the ones above n
+    // over what n just wrote
+    // only region n's own range can change: within it, n and then the
+    // regions above it that overlap
+    u32 rgn = PU_Region[n];
+    u32 lo = 0, hi = 0x100000;
+    if (rgn & 1)
+    {
+        u32 size = std::max((int)((rgn>>1) & 0x1F) - 11, 0);
+        lo = ((rgn >> 12) >> size) << size;
+        hi = lo + (1u << size);
+    }
+    UpdatePURegionOnly(n, lo, hi);
+    for (u32 i = n + 1; i < 8; i++)
+        UpdatePURegionOnly(i, lo, hi);
+}
+
+void ARMv5::UpdatePURegionOnly(u32 n, u32 clipLo, u32 clipHi)
 {
     if (!(CP15Control & (1<<0)))
         return;
@@ -252,17 +273,52 @@ void ARMv5::UpdatePURegion(u32 n)
         PU_CodeRW
     );
 
+    start = std::max(start, clipLo);
+    end = std::min(end, clipHi);
+    if (start >= end)
+        return;
     for (u32 i = start; i < end; i++)
     {
         PU_UserMap[i] = usermask;
         PU_PrivMap[i] = privmask;
     }
 
-    UpdateRegionTimings(start, end);
+    UpdateRegionTimingsOnly(start, end);
+}
+
+u64 ARMv5::PUKey() const
+{
+    u64 h = 1469598103934665603ull;
+    auto mix = [&](u64 v) { h = (h ^ v) * 1099511628211ull; };
+    for (int i = 0; i < 8; i++) mix(PU_Region[i]);
+    mix(PU_DataRW); mix(PU_CodeRW); mix(PU_DataCacheable); mix(PU_DataCacheWrite); mix(PU_CodeCacheable);
+    mix(CP15Control & 0x1005);
+    return h;
+}
+
+void ARMv5::PUSelectSet(int set)
+{
+    PU_Set = set;
+    PU_PrivMap = PU_MapBuf[set][0];
+    PU_UserMap = PU_MapBuf[set][1];
+    MemTimings = MemTimingsBuf[set];
+    PU_Map = ((CPSR & 0x1F) == 0x10) ? PU_UserMap : PU_PrivMap;
 }
 
 void ARMv5::UpdatePURegions(bool update_all)
 {
+    {
+        int set = (CP15Control & 1) ? 0 : 1;
+        u64 key = PUKey();
+        bool swapped = set != PU_Set;
+        PUSelectSet(set);
+        if (PU_SetValid[set] && PU_SetKey[set] == key)
+            return;
+        if (swapped || !PU_SetValid[set])
+            update_all = true;
+        PU_SetValid[set] = true;
+        PU_SetKey[set] = key;
+    }
     if (!(CP15Control & (1<<0)))
     {
         // PU disabled
@@ -274,7 +330,7 @@ void ARMv5::UpdatePURegions(bool update_all)
         memset(PU_UserMap, mask, 0x100000);
         memset(PU_PrivMap, mask, 0x100000);
 
-        UpdateRegionTimings(0x00000, 0x100000);
+        UpdateRegionTimingsOnly(0x00000, 0x100000);
         return;
     }
 
@@ -286,17 +342,23 @@ void ARMv5::UpdatePURegions(bool update_all)
 
     for (int n = 0; n < 8; n++)
     {
-        UpdatePURegion(n);
+        UpdatePURegionOnly(n);
     }
 
     // TODO: this is way unoptimized
     // should be okay unless the game keeps changing shit, tho
-    if (update_all) UpdateRegionTimings(0x00000, 0x100000);
+    if (update_all) UpdateRegionTimingsOnly(0x00000, 0x100000);
 
     // TODO: throw exception if the region we're running in has become non-executable, I guess
 }
 
 void ARMv5::UpdateRegionTimings(u32 addrstart, u32 addrend)
+{
+    PU_SetValid[PU_Set ^ 1] = false; // the other set's timings are stale now
+    UpdateRegionTimingsOnly(addrstart, addrend);
+}
+
+void ARMv5::UpdateRegionTimingsOnly(u32 addrstart, u32 addrend)
 {
     for (u32 i = addrstart; i < addrend; i++)
     {
